generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id         Int      @id @default(autoincrement())
  fullName   String
  email      String   @unique
  jobTitle   String
  department String
  country    String
  // annual base pay in whole units of `currency`
  salary     Int
  currency   String
  hireDate   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
